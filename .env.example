# Copy to .env and fill in. Never commit .env.

# Google Gemini — synthetic data generation + LLM classifier baseline/fallback
# (GOOGLE_API_KEY is also accepted as a fallback if GEMINI_API_KEY is unset)
GEMINI_API_KEY=

# Model routing (override defaults if needed)
QORGAN_LLM_MODEL_QUALITY=gemini-2.5-pro
QORGAN_LLM_MODEL_BULK=gemini-2.5-flash

# Classifier backend: "linear" (offline embeddings + calibrated LR -- the shipping model;
# train with `python -m qorgan.classifier.linear_train`), "llm" (Gemini baseline, needs a
# key), "mock" (deterministic, zero-setup), or "xlmr" (collapsed fine-tune, not shipping).
# The app degrades to "mock" if the selected model/key isn't available.
QORGAN_CLASSIFIER_BACKEND=linear
# Embedder: "onnx" = the int8 graph the browser ships, run by the server's ONNX Runtime
# (pinned to the device runtime's version, ADR D32; files under site/models/, fetched by
# scripts/deploy_bootstrap.py); "device" = the browser's OWN embeddings through the bridge
# `npm run device:serve` (headless Chromium, WASM) -- what the shipped heads are trained and
# evaluated on (ADR D33); "sentence-transformers" (fp32) for experiments only. The server
# serves device-trained heads with "onnx" as their documented cosine-0.98 proxy.
QORGAN_EMBED_BACKEND=onnx
# The device bridge and its on-disk embedding cache (keyed by model + browser build + text).
QORGAN_DEVICE_EMBED_URL=http://127.0.0.1:8765
QORGAN_DEVICE_EMBED_CACHE=./data/cache/device_embeddings.sqlite

# Paths (all default relative to the repo root if unset; override only if needed)
QORGAN_DATA_DIR=./data
QORGAN_MODEL_DIR=./models
# QORGAN_TAXONOMY_PATH=./data/taxonomy/tactics.yaml
# QORGAN_CACHE_DIR=./data/cache/llm_predictions       # LLM prediction cache (gap G9)
# QORGAN_CORPUS_CONFIG_PATH=./configs/corpus.yaml

# ASR (offline faster-whisper model size: tiny/base/small/medium/large-v3)
QORGAN_WHISPER_MODEL_SIZE=small

# Microphone mode runs a Kazakh AND a Russian recogniser and votes per utterance (ADR D26).
# Locking keeps only the winner after N voted utterances and reopens both when its confidence
# drops (a language switch looks like that). Measured: 0 cues lost, ~39 % of decodes saved on
# a 5-minute call. 0 = OFF, the default -- code-switching is the risk and only real bilingual
# audio can test it (ADR D40).
QORGAN_ASR_LOCK_AFTER=0
QORGAN_ASR_LOCK_CONF_FLOOR=0.80

# Alert threshold (single-shot; tuned for low FPR; see src/qorgan/config.py)
QORGAN_RISK_THRESHOLD=0.59

# Alert hysteresis (gap G8 -- enter/exit thresholds so the risk meter doesn't flicker;
# exit must be <= enter)
QORGAN_RISK_THRESHOLD_ENTER=0.59
QORGAN_RISK_THRESHOLD_EXIT=0.49

# Live meter (PLAN A6, ADR D29): the warning latch cannot engage before this many committed
# utterances unless a confident hard signal fired -- a short opening window is not evidence.
QORGAN_METER_MIN_TURNS_TO_ARM=3
# Optional damping of the rise on the first N windows (alpha_up * min(1, turn/N)); 1 = off.
QORGAN_METER_SHORT_WINDOW_TURNS=1

# ASR realism (PLAN A10, ADR D31): this share of train rows also gets an ASR-styled copy at
# corpus build (lowercase, no punctuation, numerals as words -- what the on-device recogniser
# emits). 1.0 doubles train; 0 disables. Rebuild the corpus + retrain after changing it.
QORGAN_ASR_STYLE_TRAIN_FRACTION=1.0

# Reproducibility + localization
QORGAN_SEED=42
QORGAN_SUPPORTED_LOCALES=ru,kk
QORGAN_DEFAULT_LOCALE=ru

# Privacy (PLAN_2026-09 C2/C3). Phone numbers in citizen/partner reports are stored ONLY as
# HMAC-SHA256 digests salted with this key (raw numbers are never persisted). Without it
# the reports API refuses any submission that carries a number. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating the key breaks number-linking between old and new reports -- plan for it.
QORGAN_NUMBER_HMAC_KEY=
# Consented reports older than this are removed by `python -m qorgan.reports.purge`.
QORGAN_REPORT_RETENTION_DAYS=180

# Partner intake API (PLAN_2026-09 C5, ADR D19). Comma-separated `partner_id:secret[:daily_quota]`;
# secrets >= 16 chars, unique; unset = /api/v1 is closed. Issue secrets out of band, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QORGAN_PARTNER_API_KEYS=
# Default rolling-window report budget per partner (overridable per entry above).
QORGAN_PARTNER_DAILY_QUOTA=200
QORGAN_PARTNER_QUOTA_WINDOW_HOURS=24

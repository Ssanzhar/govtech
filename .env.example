# Copy to .env and fill in. Never commit .env.

# Anthropic Claude — synthetic data generation + LLM classifier baseline/fallback
ANTHROPIC_API_KEY=

# Model routing (override defaults if needed)
QORGAN_LLM_MODEL_QUALITY=claude-sonnet-5
QORGAN_LLM_MODEL_BULK=claude-haiku-4-5-20251001

# Classifier backend: "llm" (baseline/fallback) or "xlmr" (fine-tuned)
QORGAN_CLASSIFIER_BACKEND=llm

# Paths
QORGAN_DATA_DIR=./data
QORGAN_MODEL_DIR=./models

# Alert thresholds (tuned for low FPR; see src/qorgan/config.py)
QORGAN_RISK_THRESHOLD=0.7
